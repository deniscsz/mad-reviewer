# GitHub App credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI adapter (claude | opencode | cursor | codex)
MAD_REVIEWER_ADAPTER=claude
# MAD_REVIEWER_OPENCODE_MODEL=anthropic/claude-sonnet-4   # opencode only
# MAD_REVIEWER_OPENCODE_CONFIG=./opencode.review.json     # opencode only
# MAD_REVIEWER_CURSOR_MODEL=sonnet-4                       # cursor only
# CURSOR_API_KEY=                                          # cursor only (read by cursor-agent)
# MAD_REVIEWER_CODEX_MODEL=gpt-5-codex                     # codex only
# CODEX_API_KEY=                                           # codex only (read by codex exec)
# Load the reviewed repo's own native skills (.claude/skills, …); false → ignore them
MAD_REVIEWER_LOAD_REPO_SKILLS=true
# Verbose logging: when true, emit full AI prompt/response + kept-comment events
# (may include diff content; do not enable in production with sensitive PRs)
MAD_REVIEWER_DEBUG=false
# Publish a GitHub Check Run per review (needs the App's "Checks: write" permission)
# MAD_REVIEWER_CHECKS=true
# MAD_REVIEWER_CHECK_NAME=mad-reviewer
AI_TIMEOUT_MS=300000

# Orchestration
DEBOUNCE_MS=15000
MAX_RETRIES=3
WORKER_POLL_MS=2000
SQLITE_PATH=./data/queue.db

# Server
PORT=3000

# Skills
DEFAULTS_DIR=./skills/defaults
AUTO_APPLY_DIR=./skills/auto-apply

# Persona
SOUL_PATH=./SOUL.md
